{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs --port 4323 --base /portfolio",
      "startServerReadyPattern": "listening on",
      "url": ["http://localhost:4323/portfolio/"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["canonical", "is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 120 }],
        "unused-javascript": ["warn", { "maxNumericValue": 0 }],
        "uses-responsive-images": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
