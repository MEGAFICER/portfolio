---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/motion.css';

import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Seo from '../components/seo/Seo.astro';
import { profile } from '../data';
import { buildPageMeta, buildPersonJsonLd, joinUrl } from '../lib/seo';
import { THEME_STORAGE_KEY } from '../lib/theme';

// The inline script below cannot use imports, so the key is written literally.
// tests/unit/output.test.ts fails if these two ever drift apart.
const storageKey = THEME_STORAGE_KEY;

interface Props {
  title?: string;
  description?: string;
  /** Path segment for canonical/OG URLs; empty for the homepage. */
  path?: string;
  noIndex?: boolean;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = 'Physical Design Engineer, 3.5 years of netlist-to-GDSII work on taped-out 7nm and 16nm blocks. Open to Winter 2027 internships and Summer 2027 co-ops.',
  path = '',
  noIndex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://megaficer.github.io');
const siteName = `${profile.name} — ${profile.role}`;
const base = import.meta.env.BASE_URL;

const meta = buildPageMeta({
  site: site.origin,
  base,
  path,
  title,
  description,
  siteName,
  noIndex,
});

const jsonLd = buildPersonJsonLd(profile, joinUrl(site.origin, base));
---

<!doctype html>
<html lang="en" data-theme-key={storageKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo meta={meta} base={base} />

    <!--
      Resolve the theme before first paint. Keeping this inline (and tiny) is
      what prevents a light flash for visitors whose device is in dark mode.
      Logic mirrors src/lib/theme.ts; see docs/adr/ADR-0006-theming-strategy.md.
    -->
    <script is:inline>
      (function () {
        const KEY = document.documentElement.getAttribute('data-theme-key') || 'knt-theme';
        let preference = 'system';
        try {
          const stored = window.localStorage.getItem(KEY);
          if (stored === 'light' || stored === 'dark' || stored === 'system') preference = stored;
        } catch {
          /* storage blocked — fall back to the device preference */
        }
        let systemDark = false;
        try {
          systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch {
          /* very old browser — assume light */
        }
        const resolved = preference === 'system' ? (systemDark ? 'dark' : 'light') : preference;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.style.colorScheme = resolved;
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>

  <body>
    <SkipLink />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
