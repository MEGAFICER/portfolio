---
import { resumeHref } from '../../lib/resume';

interface Props {
  variant?: 'primary' | 'ghost' | 'compact';
  label?: string;
}

const { variant = 'primary', label = 'Download resume' } = Astro.props;

const classes = [
  'btn',
  variant === 'ghost' ? 'btn--ghost' : '',
  variant === 'compact' ? 'btn--ghost btn--compact' : '',
]
  .filter(Boolean)
  .join(' ');

const href = resumeHref(import.meta.env.BASE_URL);
---

<a class={classes} href={href} download data-resume-download>
  <svg class="btn__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M8 1.75a.75.75 0 0 1 .75.75v6.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V2.5A.75.75 0 0 1 8 1.75ZM2.5 12a.75.75 0 0 1 .75.75v.5h9.5v-.5a.75.75 0 0 1 1.5 0v1.25a.75.75 0 0 1-.75.75H2.5a.75.75 0 0 1-.75-.75v-1.25A.75.75 0 0 1 2.5 12Z"></path>
  </svg>
  <span>{label}</span>
  <span class="visually-hidden">(PDF, opens as a download)</span>
</a>

<script>
  import { buildResumeFilename } from '../../lib/resume';

  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-resume-download]');

  for (const link of links) {
    link.addEventListener('click', () => {
      // The timestamp is stamped at click time so repeat downloads are
      // distinguishable in the recruiter's Downloads folder.
      link.setAttribute('download', buildResumeFilename(new Date()));
    });
  }
</script>
