---
import { education } from '../../data';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="container">
    <SectionHeader
      id="education-title"
      index="07"
      kicker="Education & research"
      title="Degrees, a thesis, and a control system"
      lede="Graduate study in progress, an undergraduate degree in electrical engineering, and the hardware projects that came with them."
    />

    <div class="edu">
      <ol class="edu__degrees">
        {education.degrees.map((degree) => (
          <li class="edu__degree reveal">
            <p class="edu__period mono">{degree.period}</p>
            <h3 class="edu__degree-title">{degree.degree}</h3>
            <p class="edu__school">{degree.school}</p>
            <p class="edu__location mono">{degree.location}</p>
            <p class="edu__detail">{degree.detail}</p>
          </li>
        ))}
      </ol>

      <div class="edu__aside">
        <h3 class="edu__subhead">Research & projects</h3>
        <ul class="edu__research">
          {education.research.map((project) => (
            <li class="card reveal">
              <p class="edu__kind mono">
                {project.kind} · {project.period}
              </p>
              <h4 class="edu__project">{project.title}</h4>
              <p class="edu__detail">{project.detail}</p>
            </li>
          ))}
        </ul>

        <h3 class="edu__subhead">Awards</h3>
        <ul class="edu__awards">
          {education.awards.map((award) => (
            <li>
              <span class="edu__award-title">{award.title}</span>
              <span class="edu__award-year mono">{award.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
  }

  .edu__degrees,
  .edu__research,
  .edu__awards {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .edu__degrees {
    display: grid;
    gap: var(--space-5);
  }

  .edu__degree {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid var(--border);
  }

  .edu__period {
    font-size: var(--step--1);
    color: var(--accent);
  }

  .edu__degree-title {
    font-size: var(--step-2);
  }

  .edu__school {
    color: var(--text);
  }

  .edu__location {
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .edu__detail {
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  .edu__aside {
    display: grid;
    gap: var(--space-4);
  }

  .edu__subhead {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .edu__research {
    display: grid;
    gap: var(--space-3);
  }

  .edu__research :global(.card) {
    display: grid;
    gap: var(--space-2);
  }

  .edu__kind {
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .edu__project {
    font-size: var(--step-1);
  }

  .edu__awards {
    display: grid;
    gap: var(--space-2);
  }

  .edu__awards li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--hairline) solid var(--border);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .edu__award-year {
    color: var(--text-faint);
  }

  @media (max-width: 56rem) {
    .edu {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
