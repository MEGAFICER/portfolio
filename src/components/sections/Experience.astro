---
import { experience } from '../../data';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeader
      id="experience-title"
      index="03"
      kicker="Experience"
      title="Where the years went"
      lede={experience.intro}
    />

    <ol class="timeline">
      {experience.roles.map((role) => (
        <li class="timeline__item reveal">
          <div class="timeline__when">
            <p class="timeline__period mono">{role.period}</p>
            <p class="timeline__duration mono">{role.duration}</p>
            <p class="timeline__location mono">{role.location}</p>
            <p class="timeline__type mono">{role.type}</p>
          </div>

          <div class="timeline__what">
            <h3 class="timeline__role">{role.role}</h3>
            <p class="timeline__company">
              {role.company}
              {role.formerName && <span class="timeline__former"> · {role.formerName}</span>}
            </p>
            <p class="timeline__summary">{role.summary}</p>

            <ul class="timeline__highlights">
              {role.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>

            <ul class="chip-row timeline__tech">
              {role.technologies.map((technology) => (
                <li class="chip">{technology}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 13rem minmax(0, 1fr);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: var(--hairline) solid var(--border);
  }

  .timeline__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .timeline__when {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    position: relative;
    padding-left: var(--space-4);
  }

  .timeline__when::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .timeline__period {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
  }

  .timeline__duration,
  .timeline__location,
  .timeline__type {
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .timeline__role {
    font-size: var(--step-2);
    margin-bottom: var(--space-1);
  }

  .timeline__company {
    font-size: var(--step-1);
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  .timeline__former {
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  .timeline__summary {
    color: var(--text);
    max-width: 68ch;
    margin-bottom: var(--space-3);
  }

  .timeline__highlights {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    max-width: 76ch;
  }

  .timeline__highlights li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .timeline__highlights li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.72em;
    width: 6px;
    height: 1px;
    background: var(--border-strong);
  }

  .timeline__tech {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 50rem) {
    .timeline__item {
      grid-template-columns: minmax(0, 1fr);
    }

    .timeline__when {
      grid-template-columns: repeat(auto-fit, minmax(7rem, auto));
      gap: var(--space-2) var(--space-4);
    }

    .timeline__when::before {
      top: 0.5em;
    }
  }
</style>
