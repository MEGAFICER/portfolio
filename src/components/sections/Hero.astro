---
import { profile } from '../../data';
import DownloadResume from '../ui/DownloadResume.astro';

const mailto = `mailto:${profile.email}`;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="blueprint" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy intro">
      <p class="hero__eyebrow label">
        <span class="hero__dot" aria-hidden="true"></span>
        {profile.role} · {profile.location.display}
      </p>

      <h1 class="hero__name" id="hero-title">
        {profile.name}
      </h1>

      <p class="hero__headline">{profile.headline}</p>

      <ul class="hero__cta">
        <li>
          <DownloadResume />
        </li>
        <li>
          <a class="btn btn--ghost" href={profile.links.linkedin} rel="me noopener" target="_blank">
            LinkedIn
          </a>
        </li>
        <li>
          <a class="btn btn--ghost" href={mailto}>
            Email
          </a>
        </li>
      </ul>

      <div class="hero__availability">
        <p class="chip chip--accent">{profile.availability.status}</p>
        <p class="hero__note">{profile.availability.note}</p>
      </div>
    </div>

    <aside class="hero__panel card ticked" aria-label="Profile summary">
      <p class="hero__panel-title mono">
        <span aria-hidden="true">▚</span> Profile
      </p>
      <dl class="hero__spec">
        <div>
          <dt>Now</dt>
          <dd>Full-time MEng, University of Ottawa</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Physical design · STA · signoff</dd>
        </div>
        <div>
          <dt>Terms</dt>
          <dd>Winter 2027 internship · Summer 2027 co-op</dd>
        </div>
        <div>
          <dt>Regions</dt>
          <dd>{profile.availability.regions.join(' · ')}</dd>
        </div>
        <div>
          <dt>Modes</dt>
          <dd>{profile.availability.modes.join(' · ')}</dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>{profile.languages.map((language) => language.name).join(' · ')}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 6vw, 5rem);
    border-bottom: var(--hairline) solid var(--border);
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: start;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    letter-spacing: var(--tracking-widest);
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero__name {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .hero__headline {
    font-size: clamp(1.0625rem, 0.98rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__availability {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--border);
  }

  .hero__availability :global(.chip) {
    white-space: normal;
    text-align: left;
    line-height: 1.4;
  }

  .hero__note {
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: 52ch;
  }

  .hero__panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--card-highlight), color-mix(in oklab, var(--surface) 92%, var(--accent));
  }

  .hero__panel-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hero__spec {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .hero__spec > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: var(--hairline) solid var(--border);
  }

  .hero__spec > div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .hero__spec dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    padding-top: 0.2em;
  }

  .hero__spec dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text);
  }

  @media (max-width: 58rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__panel {
      max-width: 34rem;
    }
  }
</style>
